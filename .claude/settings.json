{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type:check)",
      "Bash(gh:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(node:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__shadcn__get_component",
      "mcp__shadcn__list_components"
    ],
    "ask": [],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rmdir:*)",
      "Bash(npm run:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:pull)",
      "Bash(pnpm migrate:dev)",
      "Bash(pnpm migrate:prod)",
      "Bash(pnpm migrate:createonly)",
      "Bash(pnpm migrate:reset)",

      "Bash(cat *.env*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.preview)",
      "Read(**/.env.test)",

      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.test)",

      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ]
  }
}
