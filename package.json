{
  "name": "faster-fixes",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "build:packages": "turbo run build --filter='@fasterfixes/*'",
    "check:packages": "pnpm build:packages && turbo run typecheck lint --filter='@fasterfixes/*' && pnpm publint",
    "publint": "pnpm -r --filter \"@fasterfixes/*\" exec publint --strict",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && prettier --write \"**/CHANGELOG.md\" pnpm-lock.yaml",
    "release": "pnpm build:packages && changeset publish",
    "prepare": "husky",
    "sandcastle": "npx tsx .sandcastle/main.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "publint": "^0.3.24",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
