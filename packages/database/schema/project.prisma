model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  domain         String @map("url")
  publicId       String @unique
  apiKeyHash     String
  apiKeyLastFour String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  widgetConfig WidgetConfig?
  reviewers    Reviewer[]
  feedback     Feedback[]
  videos       Video[]
  gitHubLink   ProjectGitHubLink?
  linearLink   ProjectLinearLink?
  jiraLink     ProjectJiraLink?
  slackLink    ProjectSlackLink?

  @@index([organizationId])
  @@index([publicId])
  @@map("project")
}

model WidgetConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  @@map("widget_config")
}

model Reviewer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Set for a Reviewer of a Video; null for a Widget Reviewer. Postgres treats
  // nulls as distinct, so the unique pair binds video Reviewers only.
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  name     String
  token    String  @unique
  isActive Boolean @default(true)

  feedback Feedback[]

  @@unique([videoId, name])
  @@index([projectId])
  @@map("reviewer")
}

/// A trigger (`feedback_clear_rank_on_status_change`, see ADR-0017) deletes the
/// Feedback's `FeedbackRank` row whenever `status` changes, whatever the writer.
model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  // A Feedback with a `videoId` is a video Feedback, any other a page Feedback
  // (ADR-0020). `projectId` stays required and equals the Video's Project.
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  status  String @default("new")
  comment String
  pageUrl String

  clickX   Float?
  clickY   Float?
  selector String?

  // Video Selection: an instant (`endMs` null) or a range, and an optional
  // point or area on the frame in normalized 0..1 coordinates.
  startMs     Int?
  endMs       Int?
  frameX      Float?
  frameY      Float?
  frameWidth  Float?
  frameHeight Float?

  browserName    String?
  browserVersion String?
  os             String?
  viewportWidth  Int?
  viewportHeight Int?

  metadata Json?

  // Diagnostic Trail: console + network snapshot captured by the widget at
  // submission. Read lazily by the dashboard modal only; never selected on
  // the widget read path (kept out of the hot getFeedback query).
  diagnosticTrail Json?

  // Custom metadata: key/value pairs the host site declared, normalised on
  // ingest (ADR-0018). Never selected on the widget read path: a Reviewer must
  // not see another Reviewer's pairs.
  customMetadata Json?

  screenshotId String?
  screenshot   Asset?  @relation("FeedbackScreenshot", fields: [screenshotId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  issueLink       FeedbackIssueLink?
  linearIssueLink FeedbackLinearIssueLink?
  jiraIssueLink   FeedbackJiraIssueLink?
  slackMessage    FeedbackSlackMessage?
  rank            FeedbackRank?

  @@index([projectId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@index([videoId])
  @@map("feedback")
}

/// A Feedback's place within its Status column (ADR-0017). Kept out of the
/// `feedback` row so a Rank write never bumps `Feedback.updatedAt`.
model FeedbackRank {
  feedbackId String   @id
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  // Fractional-index key, compared lexicographically.
  key String

  @@map("feedback_rank")
}
