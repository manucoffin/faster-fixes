model TrelloInstallation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The Trello member who authorized. The token is bound to that member's grant:
  // there is no Workspace selection step, so the Installation reaches every
  // board that member can reach.
  trelloMemberId    String
  memberDisplayName String

  // Encrypted at rest with AES-256-GCM via trello/token-crypto.ts, under a key
  // dedicated to Trello (ADR 0003).
  accessToken    String // ciphertext
  refreshToken   String? // ciphertext
  tokenScope     String
  tokenExpiresAt DateTime?

  // "connected" | "reconnect_required". reconnect_required is set only when
  // Trello explicitly refuses the grant, never on a transient failure.
  healthState String @default("connected")

  // When the organization was last emailed about a reconnect_required flip, so
  // each failing call does not send one more email.
  reconnectNotifiedAt DateTime?

  installedById String?
  installedBy   Member? @relation(fields: [installedById], references: [id], onDelete: SetNull)

  projectLinks ProjectTrelloLink[]

  @@index([organizationId])
  @@map("trello_installation")
}

model ProjectTrelloLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  trelloInstallationId String
  trelloInstallation   TrelloInstallation @relation(fields: [trelloInstallationId], references: [id], onDelete: Cascade)

  boardId   String
  boardName String
  boardUrl  String

  // The Status mapping of ADR 0024: Trello has no status primitive, so the
  // lists standing for each Status are chosen by the User. Mapped lists are
  // distinct, so a list always names one Status.
  newListId        String
  inProgressListId String?
  resolvedListId   String

  autoCreateIssues Boolean  @default(true)
  defaultLabelIds  String[] @default([])

  // The id of the webhook Faster Fixes registered on the board, so unlinking
  // and disconnecting can remove it.
  webhookId String?

  linkHealthIssue String? // null=healthy

  feedbackIssueLinks FeedbackTrelloIssueLink[]

  @@index([trelloInstallationId])
  @@index([boardId])
  @@map("project_trello_link")
}

model FeedbackTrelloIssueLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbackId String   @unique
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  projectTrelloLinkId String
  projectTrelloLink   ProjectTrelloLink @relation(fields: [projectTrelloLinkId], references: [id], onDelete: Cascade)

  // `cardId` is the sync key. `cardShortLink` and `cardUrl` are for display.
  cardId        String
  cardShortLink String
  cardUrl       String

  // The card's state as last written or read, so the Status sync can tell a
  // move from an archive without another round-trip.
  listId   String
  archived Boolean @default(false)

  // The Status this link last converged on (ADR-0025), typed like
  // `Feedback.status`. Null, or a value other than the Feedback's Status, means
  // pending: the Feedback wins until Trello has converged to it.
  mirroredStatus String?

  lastSyncSource String?
  lastSyncAt     DateTime?

  @@index([projectTrelloLinkId])
  @@index([cardId])
  @@map("feedback_trello_issue_link")
}
