# Docker Compose settings. Copy to .env at the repository root:
#   cp .env.docker.example .env
# Compose passes this file to the app container, so any variable documented in
# apps/web/.env.example can be added here (integrations, S3 storage, etc.).

# Public origin, as served by your reverse proxy. BASE_URL is also read at build
# time: run `docker compose up -d --build` after changing it.
BASE_URL="https://feedback.example.com"
DOMAIN_NAME="feedback.example.com"

# Secrets. Generate each value with: openssl rand -hex 32
# Hex keeps the database password URL-safe and is the format Inngest requires
# for the signing key.
BETTER_AUTH_SECRET=""
POSTGRES_PASSWORD=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Transactional email, required for sign-up confirmations and password resets.
# Choose one provider.
MAILER_PROVIDER="smtp"
EMAIL_FROM="FasterFixes <noreply@feedback.example.com>"
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""

# MAILER_PROVIDER="resend"
# RESEND_API_KEY="re_..."

# MAILER_PROVIDER="plunk"
# PLUNK_SECRET_KEY="sk_..."

# Optional. Defaults are shown.
# APP_PORT="3000"
# INNGEST_PORT="8288"
# POSTGRES_USER="fasterfixes"
# POSTGRES_DB="fasterfixes"
# STORAGE_PROVIDER="local"
