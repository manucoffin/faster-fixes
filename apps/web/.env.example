DOMAIN_NAME="example.com"
BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"
# DATABASE_PROVIDER=postgres # Optional override: postgres | neon. Otherwise detect Neon by hostname.

# ---------------------
# 
# AUTHENTICATION
# 
# ---------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# ---------------------
# 
# STRIPE
# 
# ---------------------
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_
STRIPE_SECRET_KEY=sk_
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_
STRIPE_DEFAULT_TAX_RATE_ID=txr_
PRO_MONTHLY_PRICE_ID=price_
PRO_YEARLY_PRICE_ID=price_
AGENCY_MONTHLY_PRICE_ID=price_
AGENCY_YEARLY_PRICE_ID=price_

# ---------------------
# 
# MAILER
# 
# ---------------------
MAILER_PROVIDER=resend     # resend (default) | plunk | smtp
EMAIL_FROM=                # Full sender override, e.g. "FasterFixes <support@example.com>"
MAIL_FROM_DOMAIN=           # Optional verified sender domain; defaults to DOMAIN_NAME
COMMERCIAL_EMAIL_FROM=      # Optional sender for commercial mail (welcome email), e.g. "Manuel from Faster Fixes <manu@faster-fixes.com>"; defaults to the transactional sender
SMTP_HOST=                 # Required when MAILER_PROVIDER=smtp
SMTP_PORT=587
SMTP_SECURE=false           # true for implicit TLS on port 465
SMTP_REQUIRE_TLS=true       # Require STARTTLS (normally port 587)
SMTP_USER=                  # Set both credentials, or leave both empty for an unauthenticated relay.
SMTP_PASSWORD=""

# API provider keys (not required for SMTP)
PLUNK_SECRET_KEY=sk_
RESEND_API_KEY=re_
RESEND_SEGMENT_ID= 

# ---------------------
# 
# STORAGE
# 
# ---------------------
# STORAGE_PROVIDER=local # Optional: local | s3 | r2. Unset keeps existing R2/AWS configuration.
# STORAGE_LOCAL_PATH=./storage # Optional persistent local directory
# STORAGE_ENDPOINT=http://localhost:9000 # Optional S3-compatible endpoint
# STORAGE_FORCE_PATH_STYLE=false # Optional virtual-host addressing for custom endpoints
STORAGE_REGION=""
STORAGE_BUCKET_NAME=""
# NEXT_PUBLIC_STORAGE_BASE_URL=https://cdn.example.com/bucket # Optional public bucket or CDN URL for avatars and logos. Unset, they are served through /api/storage.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

AWS_ACCESS_KEY_ID=""
AWS_BUCKET_NAME=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# ---------------------
#
# FEEDBACK WIDGET
#
# ---------------------
NEXT_PUBLIC_FF_API_KEY=""
NEXT_PUBLIC_FF_API_ORIGIN=http://localhost:3000

# ---------------------
#
# GITHUB APP
#
# ---------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=          # Full PEM content with \n as literal newlines
GITHUB_WEBHOOK_SECRET=       # High-entropy random string for webhook signature verification

# ---------------------
#
# LINEAR INTEGRATION
#
# ---------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=    # Optional override; defaults to $BETTER_AUTH_URL/api/linear/callback
LINEAR_WEBHOOK_SIGNING_SECRET= # App-level webhook secret from Linear's OAuth app settings
LINEAR_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# SLACK INTEGRATION
#
# ---------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=   # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration

# ---------------------
#
# JIRA INTEGRATION
#
# ---------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=        # optional; falls back to BETTER_AUTH_URL/BASE_URL + /api/jira/callback
JIRA_TOKEN_ENCRYPTION_KEY=      # 32-byte hex (generate via `openssl rand -hex 32`); rotation = full re-encrypt migration
JIRA_WEBHOOK_BASE_URL=          # optional; public base URL Jira delivers webhooks to (use a tunnel locally), falls back to BETTER_AUTH_URL/BASE_URL


# ---------------------
#
# INNGEST
#
# ---------------------
INNGEST_EVENT_KEY=           # Required in production for event authentication
INNGEST_SIGNING_KEY=         # Required in production for webhook signature verification

# ---------------------
#
# DEPLOYMENT MODE
#
# ---------------------
# Set to "true" on the official hosted version to enable marketing pages (home, pricing, blog, docs, legal).
# Self-hosted instances leave this unset or "false" — users are redirected straight to /login.
NEXT_PUBLIC_IS_CLOUD=false